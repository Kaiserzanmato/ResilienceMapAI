# ResilienceMap AI — frontend environment
# Copy to .env.local and adjust for your machine. Values below are the
# project's actual defaults (see lib/feature-flags.ts) — this file is safe
# to commit since it contains no secrets, only public feature-flag toggles.

# Backend API base URL. In production this must point at the deployed
# Render backend (see ARCHITECTURE.md for the current URL).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public CARTO basemap key for dark/light/hybrid label tiles. CARTO requires
# this on basemaps.cartocdn.com tiles; request one at https://carto.com/basemaps/apikey/.
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=

# ── Feature Flags ────────────────────────────────────────────────────────
# Set to "true" or "false" to enable/disable platform features. Values here
# match lib/feature-flags.ts's built-in defaults — unset vars already
# resolve to these, so this file is documentation, not a required override.
# High-risk layers (conflict, aviation, maritime) remain disabled until
# their connectors are validated.
NEXT_PUBLIC_ENABLE_GLOBAL_SOURCE_REGISTRY=true
NEXT_PUBLIC_ENABLE_SOURCE_AUTO_SYNC=true
NEXT_PUBLIC_ENABLE_SOURCE_HEALTH_MONITORING=true
NEXT_PUBLIC_ENABLE_SYNC_AUDIT_LOGS=true

NEXT_PUBLIC_ENABLE_CONFLICT_SECURITY_LAYER=false
NEXT_PUBLIC_ENABLE_HUMANITARIAN_LAYER=true
NEXT_PUBLIC_ENABLE_AVIATION_LAYER=false
NEXT_PUBLIC_ENABLE_MARITIME_LAYER=false

NEXT_PUBLIC_ENABLE_DEEPSEEK_GROUNDED_CONTEXT=true
NEXT_PUBLIC_ENABLE_HOME_GLOBE_LOADER=true

# Current-event intelligence remains off until backend/provider production
# verification is complete. It is safe to enable independently for staging.
NEXT_PUBLIC_ENABLE_REALTIME_EVENTS=false
