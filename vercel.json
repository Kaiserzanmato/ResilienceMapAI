{
  "name": "resilience-map-ai",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    { "source": "/_/backend/:path(.*)?", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [
    {
      "path": "/_/backend/api/cron/sync-sources",
      "schedule": "0 0 * * *"
    }
  ]
}
