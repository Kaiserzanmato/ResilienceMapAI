# ResilienceMap AI — backend environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI providers (all optional; deterministic local fallback used when unset)
# Alibaba Cloud Qwen (DashScope OpenAI-compatible mode)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Xiaomi MiMo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-7b-rl

# Optional: OpenAI / Gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_REQUESTS=20

# --- Production infrastructure (schema-ready; MVP runs on curated sample data)
# Postgres connection string (provision via the Vercel Marketplace, e.g. Neon).
# When unset, sync health/audit-log/dataset/report storage falls back to
# in-memory (lost on restart) — the existing MVP behavior.
DATABASE_URL=
# Used only by Alembic migrations (backend/alembic/) — prefer the direct/
# unpooled connection string here, since DDL over a transaction pooler like
# PgBouncer can misbehave. Falls back to DATABASE_URL if unset.
ALEMBIC_DATABASE_URL=
REDIS_URL=

# --- Sync & admin hardening
# Shared secret Vercel Cron must present to hit /api/cron/sync-sources.
# Required in production (the app refuses to start without it there).
CRON_SECRET=
# Stopgap RBAC hardening: required alongside X-Role to act as anything above
# public_user/registered_user. NOT real authentication — see app/security.py.
ADMIN_SHARED_SECRET=
