# ResilienceMap AI — backend environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI providers (all optional; deterministic local fallback used when unset)
# Alibaba Cloud Qwen (DashScope OpenAI-compatible mode) — text provider
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Vision-capable Qwen model used only by POST /api/ai/spatial-vision
# (map screenshot + risk context in, grounded analysis out). Uses the same
# QWEN_API_KEY/QWEN_BASE_URL above.
QWEN_VISION_MODEL=qwen3-vl-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Together AI (OpenAI-compatible; hosts open-weight models incl. Qwen)
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo

# Xiaomi MiMo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-7b-rl

# Optional: OpenAI / Gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Firecrawl: scrapes unstructured hazard advisories into hazard_events
# (backend/app/data_sources/scrapers/firecrawl_worker.py). Optional — the
# worker safely no-ops when unset. Requires DATABASE_URL with PostGIS
# enabled (see alembic/versions/0002_hazard_events.py) to actually persist.
FIRECRAWL_API_KEY=
# Comma-separated official advisory domains. The worker rejects every other
# host, even when supplied by an administrator.
FIRECRAWL_ALLOWED_HOSTS=pagasa.dost.gov.ph,phivolcs.dost.gov.ph,ndrrmc.gov.ph,jma.go.jp

# --- Rate limiting (short-window burst protection, RateLimitMiddleware)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_REQUESTS=20

# --- Usage quotas (long-window, per-IP; app/services/usage_quota.py).
# Separate from the burst limiter above. "insights" is a tight sliding
# window (each hit is one expensive full generation from a single Insights
# click). "chat" is a daily cap (resets at UTC midnight) shared by the AI
# Agent panel and AI Workspace chat.
INSIGHTS_QUOTA_LIMIT=3
INSIGHTS_QUOTA_WINDOW=18000
CHAT_QUOTA_LIMIT=50

# --- Production infrastructure (schema-ready; MVP runs on curated sample data)
# Postgres connection string (provision via the Vercel Marketplace, e.g. Neon).
# When unset, sync health/audit-log/dataset/report storage falls back to
# in-memory (lost on restart) — the existing MVP behavior.
DATABASE_URL=
# Used only by Alembic migrations (backend/alembic/) — prefer the direct/
# unpooled connection string here, since DDL over a transaction pooler like
# PgBouncer can misbehave. Falls back to DATABASE_URL if unset.
ALEMBIC_DATABASE_URL=
REDIS_URL=

# --- Location resolution
# Required for production autocomplete. Point this at a self-hosted Photon
# service; public Nominatim is deliberately not used for live autocomplete.
PHOTON_URL=
# Production property/place search: Geoapify is first choice, LocationIQ is
# the fallback. Keep keys server-side and set provider URL defaults unless a
# contracted regional endpoint is used.
GEOCODER_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode/search
LOCATIONIQ_ACCESS_TOKEN=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1/search
GEOCODER_TIMEOUT_SECONDS=3
GEOCODER_MAX_RESULTS=8
GEOCODER_CACHE_TTL_SECONDS=300
GEOCODER_MIN_QUERY_LENGTH=3
GEOCODER_ENABLE_FALLBACK=true

# --- Sync & admin hardening
# Shared secret Vercel Cron must present to hit /api/cron/sync-sources.
# Required in production (the app refuses to start without it there).
CRON_SECRET=
# Stopgap RBAC hardening: required alongside X-Role to act as anything above
# public_user/registered_user. NOT real authentication — see app/security.py.
ADMIN_SHARED_SECRET=

# --- Current event intelligence (feature-gated until production validation)
ENABLE_REALTIME_EVENTS=false
ENABLE_USGS_EVENTS=true
ENABLE_GDACS_EVENTS=true
ENABLE_EONET_ENRICHMENT=true
ENABLE_RELIEFWEB_ENRICHMENT=true
EVENTS_CACHE_TTL_SECONDS=300
EVENTS_MAX_RESPONSE_BYTES=2097152
